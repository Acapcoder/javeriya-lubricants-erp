# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Leave unset for the embedded database (local development only).
# Production MUST point at a real PostgreSQL server; the app refuses to start
# in production with an embedded database. TLS is applied automatically for any
# non-local host.
#
# Supabase: use the SESSION pooler (5432) locally, and the TRANSACTION pooler
# (6543) on Vercel. See DEPLOY.md.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Security ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
COOKIE_SECURE=true

# --- Server -----------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3200
TOTP_ISSUER=ORCMS

# --- Two-factor authentication ----------------------------------------------
# true  = mandatory for Administrator and Accountant (IMPLEMENTATION.md §6.1)
# false = opt-in; nobody is forced through enrolment, but anyone who HAS
#         enrolled is still challenged.
# Must be true at go-live. The server logs a warning on every boot while it is off.
ENFORCE_2FA=true

# --- Policy (defaults match IMPLEMENTATION.md §6.1 and §10) -----------------
SESSION_LIFETIME_MINUTES=480
SESSION_IDLE_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12

# --- Bootstrap administrator ------------------------------------------------
# Created on first seed only. Sign in is by username, not email.
# Change the password immediately after first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
